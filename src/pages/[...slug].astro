---
import {pages,articles,href,config,indexable} from '../lib/content.mjs';
import '../styles/site.css';
import AirportGuide from '../components/AirportGuide.astro';
export function getStaticPaths(){return pages.map(page=>({params:{slug:page.slug||undefined},props:{page}}))}
const {page}=Astro.props;const home=!page.slug;const article=page.slug.startsWith('blog/');const tech=config.mode==='tech';
const nav=[['downloads','下载'],['mobile','手机版'],['desktop','电脑版'],['tutorials','教程'],['blog','博客'],['recommend','机场推荐']];
const canonical=new URL(page.slug?page.slug+'/':'',config.site).href;
const updated=new Date(page.lastmod||page.date||'2026-09-30').toLocaleDateString('zh-CN');
const schema={'@context':'https://schema.org','@type':article?'Article':'WebPage',headline:page.title,url:canonical,description:page.description,...(article?{datePublished:page.date,dateModified:page.lastmod||page.date,author:{'@type':'Organization',name:'Clash 编辑组'}}:{})};
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{home?page.title:`${page.title} | ${config.title}`}</title><meta name="description" content={page.description||config.description}/><meta name="robots" content={indexable?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/><link rel="alternate" type="application/rss+xml" title="Clash 文章" href={href('rss.xml')}/><meta property="og:title" content={page.title}/><meta property="og:description" content={page.description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('< ','&lt;')}></script></head>
<body class={config.mode}><a class="skip" href="#main">跳到内容</a><header class="header"><a class="brand" href={href('')}><span class="brand-icon">C</span>{config.title}</a><nav aria-label="主导航">{nav.map(([url,label])=><a href={href(url+'/')} aria-current={page.slug===url?'page':undefined}>{label}</a>)}</nav><a class="header-action" href={href('downloads/')}>下载入口</a></header>
<div class="shell">
{!tech&&<aside class="sidebar"><p class="side-label">使用手册</p><a href={href('')}>概览</a>{nav.map(([url,label])=><a href={href(url+'/')} aria-current={page.slug===url?'page':undefined}>{label}</a>)}<p class="side-label">解决具体问题</p>{articles.map(a=><a href={href(a.slug+'/')}>{a.title}</a>)}<div class="side-note">软件下载直接前往<br/>开发者发布页面。</div></aside>}
<main id="main">
{home?<><header class="route-intro"><h1>Clash 下载中心<br/>安卓与电脑客户端指南</h1><p>按你正在做的事，找到下一步。Clash 下载、订阅和连接排查指南。</p></header><div class="route-workspace"><nav class="route-nav" aria-label="使用阶段"><a href="#choose"><b>选择客户端</b><span>从手机或电脑开始</span></a><a href="#configure"><b>导入与设置</b><span>让客户端读取配置</span></a><a href="#diagnose"><b>检查连接</b><span>定位请求在哪一步中断</span></a><a href={href('recommend/')}><b>机场推荐</b><span>套餐与流量条件比较</span></a><a class="route-all" href={href('blog/')}>浏览全部文章</a></nav><div class="route-content"><section id="choose" class="stage"><div class="stage-heading"><span class="stage-dot" aria-hidden="true"></span><h2>选择适合设备的客户端</h2></div><p>先核对系统和架构，再从开发者发行页取安装包。</p><div class="device-shelf"><a href={href('mobile/')}><svg aria-hidden="true" width="34" height="42" viewBox="0 0 34 42" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="2" width="20" height="37" rx="4"/><path d="M15 6h6m-5 28h4"/></svg><span><strong>Android 手机</strong><small>APK、权限与首次连接</small></span></a><a href={href('desktop/')}><svg aria-hidden="true" width="42" height="42" viewBox="0 0 42 42" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="36" height="24" rx="2"/><path d="M21 30v6m-10 0h20"/></svg><span><strong>Windows 与 Mac</strong><small>桌面客户端与安装包</small></span></a></div><a class="source-entry" href={href('downloads/')}>查看所有下载来源</a></section><section id="configure" class="stage"><div class="stage-heading"><span class="stage-dot" aria-hidden="true"></span><h2>把配置交给客户端</h2></div><p>下载完成后，接着确认订阅内容、运行模式和流量接管范围。</p><div class="stage-links">{articles.filter(a=>/subscription|modes/.test(a.slug)).map(a=><a href={href(a.slug+'/')}><h3>{a.title}</h3><p>{a.description}</p></a>)}</div></section><section id="diagnose" class="stage"><div class="stage-heading"><span class="stage-dot" aria-hidden="true"></span><h2>遇到问题，按现象查</h2></div><p>区分安装失败、配置失败和访问失败，比反复切换模式更容易找到原因。</p><div class="stage-links">{articles.filter(a=>/android|windows/.test(a.slug)).map(a=><a href={href(a.slug+'/')}><h3>{a.title}</h3><p>{a.description}</p></a>)}</div></section><section class="more-notes"><h2>还可以读</h2>{articles.filter(a=>/backup|official|migration-record/.test(a.slug)).map(a=><a href={href(a.slug+'/')}>{a.title}</a>)}</section></div></div></>:<><div class="breadcrumb"><a href={href('')}>首页</a><span>/</span><span>{article?'博客文章':page.title}</span></div><header class="page-head"><p class="eyebrow">{article?'配置笔记':'使用指南'}</p><h1>{page.title}</h1><p>{page.description}</p>{article&&<small>更新于 {updated} · Clash 编辑组</small>}</header><div class="reading-layout"><div class="reading">{page.slug==='recommend'?<AirportGuide link={href} download="downloads/" tutorial="tutorials/"/>:<article class="prose" set:html={page.html}/>}{page.slug==='blog'&&<><label class="search-label" for="article-search">搜索文章</label><input id="article-search" type="search" placeholder="输入安装、订阅或规则…"/><p id="search-status" role="status"></p><div class="posts">{articles.map(a=><a class="post" data-post data-text={a.title+' '+a.description} href={href(a.slug+'/')}><div><h2>{a.title}</h2><p>{a.description}</p></div><span>↗</span></a>)}</div></>}{article&&<a class="back-link" href={href('blog/')}>← 返回全部文章</a>}</div>{page.toc.length>0&&<aside class="toc"><p>本页内容</p>{page.toc.map(t=><a href={'#'+t.id}>{t.text}</a>)}</aside>}</div></>}
<footer><span>© 2026 {config.title}</span><div><a href={href('about/')}>关于</a><a href={href('privacy/')}>隐私</a><a href={href('rss.xml')}>RSS</a></div></footer></main></div>
<script>const input=document.querySelector('#article-search');if(input)input.addEventListener('input',()=>{const q=(input as HTMLInputElement).value.trim().toLowerCase();let total=0;document.querySelectorAll<HTMLElement>('[data-post]').forEach(card=>{card.hidden=!card.dataset.text?.toLowerCase().includes(q);if(!card.hidden)total++});document.querySelector('#search-status')!.textContent=total+' 篇文章'});</script>
</body></html>


